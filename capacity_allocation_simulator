# capacity_allocation_simulator.py
# Personal Portfolio - Data Center Capacity Simulator (v2.0 - ENHANCED)
# Demonstrates: Multi-constraint optimization, SLA-aware prioritization, partial P2 throttling,
#              overcommit detection, failure modes, and concrete scenario metrics

"""
SCENARIO:
Data center zone facing power and/or cooling constraints (grid brownout, CRAC failure, density spikes).
Competing workloads: P0 (critical SLA-bound), P1 (revenue-important), P2 (best-effort ML/training).

KEY ENHANCEMENTS:
- Partial allocation (throttling) for P2 workloads — enables realistic "reduce by X%" metrics
- Always computes both power & cooling utilization with explicit overcommit flags
- Multiple concrete scenarios with quantified outputs (SLA %, reduction %, revenue loss)
- Failure mode visibility: single-constraint risks hidden breaches; severe cases impact higher tiers
- Performance notes: O(W log W + W × Z) time (W = workloads, Z = zones). Latency <1ms for W≤1000, Z≤10.

REAL-WORLD RELEVANCE:
Exact problem faced by TPMs during incidents — preserve user-facing SLAs while maximizing utilization
and providing auditable trade-off reasoning.
"""

from dataclasses import dataclass, field
from typing import List, Dict, Literal
import logging
import copy

logging.basicConfig(level=logging.INFO, format='%(levelname)s: %(message)s')
logger = logging.getLogger(__name__)

@dataclass
class Workload:
    name: str
    priority: Literal["P0", "P1", "P2"]
    power_watts: float      # Full requested power
    revenue_per_hour: float
    requires_high_availability: bool

@dataclass
class DataCenterZone:
    zone_id: str
    max_power_kw: float
    max_cooling_tons: float
    current_power_kw: float = 0.0
    current_cooling_tons: float = 0.0
    allocated_workloads: List[str] = field(default_factory=list)

class CapacityAllocator:
    """
    SLA-aware allocator with P0/P1 all-or-nothing and P2 partial throttling.
    Performance: O(W log W + W × Z) — negligible latency at scale.
    """
    
    def __init__(self, zones: List[DataCenterZone], workloads: List[Workload]):
        self.zones = zones
        self.workloads = workloads

    def _get_remaining_capacity_kw(self, zone: DataCenterZone, mode: str) -> float:
        rem_power = zone.max_power_kw - zone.current_power_kw
        rem_cooling_kw = (zone.max_cooling_tons - zone.current_cooling_tons) * 12.0
        
        if mode == "power":
            return rem_power
        elif mode == "cooling":
            return rem_cooling_kw
        else:  # "both" or default
            return min(rem_power, rem_cooling_kw)

    def allocate(self, constraint_mode: Literal["power", "cooling", "both"]) -> Dict:
        # Reset zones
        for z in self.zones:
            z.current_power_kw = 0.0
            z.current_cooling_tons = 0.0
            z.allocated_workloads = []

        # Sort: P0 > P1 > P2, then revenue density within tier
        sorted_workloads = sorted(
            self.workloads, 
            key=lambda w: (
                0 if w.priority == "P0" else 1 if w.priority == "P1" else 2,
                -(w.revenue_per_hour / w.power_watts)
            )
        )

        allocation_details = {}
        revenue_loss = 0.0
        violations = []          # P0/P1 not fully placed
        throttled = []            # P2 partial allocations

        p0_p1_requested_kw = 0.0
        p0_p1_allocated_kw = 0.0
        p2_requested_kw = 0.0
        p2_allocated_kw = 0.0

        for workload in sorted_workloads:
            req_kw = workload.power_watts / 1000.0
            allocated_kw = 0.0
            allocated_zone = None

            if workload.priority != "P2":
                # All-or-nothing for SLA/revenue-critical
                for zone in self.zones:
                    rem_kw = self._get_remaining_capacity_kw(zone, constraint_mode)
                    if rem_kw >= req_kw - 0.001:
                        allocated_kw = req_kw
                        allocated_zone = zone
                        break
            else:
                # Best-effort partial for P2
                max_possible = 0.0
                best_zone = None
                for zone in self.zones:
                    rem_kw = self._get_remaining_capacity_kw(zone, constraint_mode)
                    if rem_kw > max_possible:
                        max_possible = rem_kw
                        best_zone = zone
                
                allocated_kw = min(req_kw, max_possible)
                allocated_zone = best_zone

            if allocated_kw > 0 and allocated_zone is not None:
                alloc_tons = allocated_kw / 12.0
                allocated_zone.current_power_kw += allocated_kw
                allocated_zone.current_cooling_tons += alloc_tons
                
                fraction = allocated_kw / req_kw if req_kw > 0 else 1.0
                label = workload.name if abs(fraction - 1.0) < 0.01 else f"{workload.name} ({fraction:.1%})"
                allocated_zone.allocated_workloads.append(label)
                
                allocation_details[workload.name] = {
                    "allocated_kw": round(allocated_kw, 2),
                    "fraction": fraction,
                    "zone": allocated_zone.zone_id
                }

            loss_fraction = 1.0 - (allocated_kw / req_kw if req_kw > 0 else 0.0)
            revenue_loss += loss_fraction * workload.revenue_per_hour

            if workload.priority in ["P0", "P1"]:
                p0_p1_requested_kw += req_kw
                p0_p1_allocated_kw += allocated_kw
                if loss_fraction > 0.01:
                    violations.append(workload.name)
            else:
                p2_requested_kw += req_kw
                p2_allocated_kw += allocated_kw
                if 0.01 < loss_fraction < 0.99:
                    throttled.append((workload.name, fraction))

        # Zone utilization & overcommit detection
        zone_utils = []
        for zone in self.zones:
            power_util = zone.current_power_kw / zone.max_power_kw * 100 if zone.max_power_kw else 0
            cooling_util = zone.current_cooling_tons / zone.max_cooling_tons * 100 if zone.max_cooling_tons else 0
            
            zone_utils.append({
                "zone_id": zone.zone_id,
                "power_used_kw": round(zone.current_power_kw, 2),
                "power_util_%": round(power_util, 1),
                "power_over": zone.current_power_kw > zone.max_power_kw + 0.01,
                "cooling_used_tons": round(zone.current_cooling_tons, 2),
                "cooling_util_%": round(cooling_util, 1),
                "cooling_over": zone.current_cooling_tons > zone.max_cooling_tons + 0.01,
                "allocated": zone.allocated_workloads
            })

        p0_p1_sla_pct = (p0_p1_allocated_kw / p0_p1_requested_kw * 100) if p0_p1_requested_kw else 100
        p2_reduction_pct = (1 - p2_allocated_kw / p2_requested_kw) * 100 if p2_requested_kw else 0

        return {
            "constraint_mode": constraint_mode,
            "zone_utilizations": zone_utils,
            "critical_violations": violations,
            "throttled_p2": throttled,
            "p0_p1_sla_%": round(p0_p1_sla_pct, 1),
            "p2_reduction_%": round(p2_reduction_pct, 1),
            "revenue_loss_hourly": round(revenue_loss, 2)
        }

# === Simulation Scenarios ===
if __name__ == "__main__":
    base_zones = [
        DataCenterZone("us-east-1a", max_power_kw=50.0, max_cooling_tons=4.0),
        DataCenterZone("us-east-1b", max_power_kw=200.0, max_cooling_tons=16.0)
    ]
    
    base_workloads = [
        Workload("Search-Index-Rack-A", "P0", 50000, 10000, True),
        Workload("AI-Training-Rack-GPUs", "P1", 100000, 8000, True),
        Workload("Ads-Bidding-Rack-B", "P0", 40000, 15000, True),
        Workload("ML-Training-Cluster", "P2", 80000, 200, False),
        Workload("Analytics-Ingest-Shard", "P1", 20000, 5000, False),
    ]

    def run_scenario(title: str, mode: str, cooling_factor: float = 1.0):
        scenario_zones = copy.deepcopy(base_zones)
        for z in scenario_zones:
            z.max_cooling_tons *= cooling_factor
        
        sim = CapacityAllocator(scenario_zones, base_workloads)
        result = sim.allocate(mode)
        
        print(f"\n=== {title} ===")
        print(f"Mode: {result['constraint_mode']}")
        if cooling_factor < 1.0:
            print(f"Cooling capacity reduced to {cooling_factor:.0%}")
            
        print(f"P0/P1 SLA maintained: {result['p0_p1_sla_%']}%")
        print(f"P2 capacity reduction: {result['p2_reduction_%']}%")
        print(f"Hourly revenue loss: ${result['revenue_loss_hourly']:,.2f}")
        print(f"Critical SLA violations: {result['critical_violations'] or 'None'}")
        
        print("Zone status:")
        for zu in result['zone_utilizations']:
            overs = []
            if zu['power_over']: overs.append("Power")
            if zu['cooling_over']: overs.append("Cooling")
            over_str = f" (OVERCOMMIT: {', '.join(overs)})" if overs else ""
            print(f"  {zu['zone_id']}: Power {zu['power_util_%']}%, Cooling {zu['cooling_util_%']}%{over_str}")
            print(f"    Allocated: {', '.join(zu['allocated']) or 'Empty'}")

    run_scenario("1. Power Constraint Only (risks hidden cooling breach)", "power")
    run_scenario("2. Safe Multi-Constraint (Power + Cooling)", "both")
    run_scenario("3. Cooling-Only Constraint", "cooling")
    run_scenario("4. Severe Crisis: 30% Cooling Loss", "both", cooling_factor=0.7)
